{
  "name": "open-agent-connect",
  "version": "0.8.0",
  "private": false,
  "license": "MIT",
  "author": "Sunny Fung",
  "description": "Open-source Open Agent Internet runtime, CLI, and host skill packs for MetaBots.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagentinternet/open-agent-connect.git"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "metabot": "dist/cli/main.js",
    "oac": "dist/oac/main.js"
  },
  "files": [
    "dist/",
    "SKILLs/metabot-browser/SKILL.md",
    "SKILLs/metabot-browser-open/SKILL.md",
    "SKILLs/metabot-call-remote-service/SKILL.md",
    "SKILLs/metabot-chat-privatechat/SKILL.md",
    "SKILLs/metabot-help/SKILL.md",
    "SKILLs/metabot-identity-manage/SKILL.md",
    "SKILLs/metabot-network-manage/SKILL.md",
    "SKILLs/metabot-omni-reader/SKILL.md",
    "SKILLs/metabot-post-buzz/SKILL.md",
    "SKILLs/metabot-post-skillservice/SKILL.md",
    "SKILLs/metabot-create-wiki/SKILL.md",
    "SKILLs/metabot-create-wiki/scripts/",
    "SKILLs/metabot-create-wiki/assets/",
    "SKILLs/metabot-metaapp/SKILL.md",
    "SKILLs/metabot-schedule/SKILL.md",
    "SKILLs/metabot-upload-file/SKILL.md",
    "SKILLs/metabot-wallet-manage/SKILL.md",
    "skillpacks/common/templates/",
    "src/browser/",
    "src/ui/",
    "scripts/oac-dev-mode.sh",
    "docs/install/open-agent-connect.md",
    "release/compatibility.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm exec rimraf dist && tsc -p tsconfig.json",
    "closeout:eric": "bash scripts/closeout-eric.sh",
    "dev:daemon": "bash scripts/dev-daemon.sh",
    "dev:mode": "bash scripts/oac-dev-mode.sh",
    "check:agent-browser-core": "node scripts/check-agent-browser-core-version.mjs",
    "bump:agent-browser-core": "node scripts/bump-agent-browser-core-version.mjs",
    "test:setup": "node scripts/preflight-playwright.mjs",
    "build:skillpacks": "node scripts/build-metabot-skillpacks.mjs",
    "build:packs": "node scripts/build-release-packs.mjs",
    "pretest": "pnpm run test:setup",
    "test": "pnpm run build && node scripts/run-tests-with-leak-guard.mjs",
    "test:raw": "node scripts/run-test-suite.mjs all",
    "pretest:fast": "pnpm run test:setup",
    "test:fast": "pnpm run build && node scripts/run-tests-with-leak-guard.mjs -- pnpm run --silent test:fast:raw",
    "test:fast:raw": "node scripts/run-test-suite.mjs fast",
    "test:integration": "pnpm run build && node scripts/run-tests-with-leak-guard.mjs -- pnpm run --silent test:integration:raw",
    "test:integration:raw": "node scripts/run-test-suite.mjs integration",
    "test:contracts": "pnpm run build && node --test tests/contracts/*.test.mjs",
    "preverify": "pnpm run test:setup",
    "verify": "pnpm run build && pnpm run build:skillpacks && node scripts/run-tests-with-leak-guard.mjs"
  },
  "dependencies": {
    "@metalet/utxo-wallet-service": "^0.3.33-beta.5",
    "@opcat-labs/scrypt-ts-opcat": "^4.0.0",
    "@openagentinternet/agent-browser-core": "0.6.0",
    "@openagentinternet/agent-browser-host-contract": "0.6.0",
    "@openagentinternet/agent-browser-name-resolvers": "0.6.0",
    "@openagentinternet/agent-browser-ui": "0.6.0",
    "@scure/bip39": "^1.6.0",
    "adm-zip": "^0.6.1",
    "bitcoinjs-lib": "^6.1.6",
    "crypto-js": "^4.2.0",
    "fast-xml-parser": "^5.11.0",
    "mammoth": "^1.12.1",
    "meta-contract": "^0.4.16",
    "pdfjs-dist": "^6.2.108",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.1",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@openagentinternet/agent-browser-test-harness": "0.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.0.1",
    "@types/turndown": "^5.0.6",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3"
  }
}
